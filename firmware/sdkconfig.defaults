CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_FREERTOS_HZ=1000

# LVGL draws in 40-line strips: the C6 has no PSRAM, so a full frame won't fit.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=40

# Wi-Fi: resync the clock over SNTP every 3 hours (the RTC holds it between).
CONFIG_LWIP_SNTP_UPDATE_DELAY=10800000

# Battery: let the chip light-sleep while the screen is off (see main/power.c).
# Light sleep is only switched on while dozing; with the screen on we run at
# full speed as before.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
