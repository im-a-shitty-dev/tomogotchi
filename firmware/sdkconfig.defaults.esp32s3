# ESP32-S3 board (ESP32-S3R8): 8 MB octal PSRAM, 240 MHz max.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM is switched on so the chip is set up properly, but nothing uses it
# yet: drawing still happens in 40-line strips in internal RAM, as on the C6.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The S3 package sizes its LVGL draw buffer from this (the C6 one uses
# BSP_DISPLAY_LVGL_BUF_HEIGHT). 40 lines, to match.
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=40
